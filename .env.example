# FLVX public-safe example environment

BACKEND_PORT=6365
FRONTEND_PORT=6366
TZ=Asia/Shanghai

JWT_SECRET=replace_with_a_new_random_secret

DB_TYPE=postgres
POSTGRES_DB=flux_panel
POSTGRES_USER=flux_panel
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://flux_panel:replace_with_strong_password@postgres:5432/flux_panel?sslmode=disable

# Optional: where nodes download patched agent assets from.
# Example: http://203.0.113.10:6366
AGENT_DOWNLOAD_BASE_URL=
AGENT_ASSET_DIR=./agent
